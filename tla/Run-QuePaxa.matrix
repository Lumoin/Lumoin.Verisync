MCConcreteTwoLeaders.cfg	QuePaxaConcrete.tla	red	Agreement
MCConcreteIdenticalKeyOnly.cfg	QuePaxaConcrete.tla	red	Agreement
MCConcreteFirstClaimBindsOnly.cfg	QuePaxaConcrete.tla	red	Agreement
MCConcreteConfiguredLeaderOnly.cfg	QuePaxaConcrete.tla	green
MCConcreteTwoLeadersGuarded.cfg	QuePaxaConcrete.tla	green
MCConcreteDeclaredScheduleBinds.cfg	QuePaxaConcrete.tla	green
MCConcreteSingleLeaderDeclaredSchedule.cfg	QuePaxaConcrete.tla	green
MCConcreteMixedLeaderlessWideDowngrade.cfg	QuePaxaConcrete.tla	red	Agreement
MCConcreteMixedLeaderlessNarrowDowngrade.cfg	QuePaxaConcrete.tla	green
MCConcreteSplitLeadersWideDowngrade.cfg	QuePaxaConcrete.tla	red	Agreement
MCConcreteSplitLeadersNarrowDowngrade.cfg	QuePaxaConcrete.tla	red	Agreement
MCDurableRecorder.cfg	QuePaxaDurable.tla	green
MCDurableVolatileReply.cfg	QuePaxaDurable.tla	red	ServedFirstIsStable
MCDurableFreshRestart.cfg	QuePaxaDurable.tla	red	ServedFirstIsStable
