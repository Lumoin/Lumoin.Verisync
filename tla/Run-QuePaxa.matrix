MCTornDurableShape.cfg	QuePaxaTornWrite.tla	red	TypeOK
MCTornStepZeroPremise.cfg	QuePaxaTornWrite.tla	green
MCTornUnguardedRestore.cfg	QuePaxaTornWrite.tla	red	RegisterHoldsOnlyRecorderStates
MCTornFabricated.cfg	QuePaxaTornWrite.tla	red	DurableRestoreKeepsEveryAnswer
MCMembershipShipped.cfg	QuePaxaMembership.tla	green
MCMembershipDisjointChange.cfg	QuePaxaMembership.tla	green
MCMembershipRemovedProposer.cfg	QuePaxaMembership.tla	green
